[Unit]
Description=No-IP Dynamic DNS update client
Documentation=https://github.com/noipcom/linux-update-client-docker
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers %h/noip

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
        --cidfile=%t/%n.ctr-id \
        --cgroups=no-conmon \
        --env-file %h/noip/noip-duc.env \
        --rm \
        --sdnotify=conmon \
        --replace \
        -d \
        --name noip-duc \
        --label io.containers.autoupdate=registry \
        ghcr.io/noipcom/noip-duc:latest
ExecStop=/usr/bin/podman stop \
        --ignore -t 10 \
        --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm \
        -f \
        --ignore -t 10 \
        --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target
